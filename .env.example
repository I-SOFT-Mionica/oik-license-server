# Copy to .env and fill in real values before running.

# REQUIRED — at least 32 random characters.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# REQUIRED — password for the /admin/ web UI.
# Generate with: python -c "import secrets; print(secrets.token_hex(24))"
ADMIN_TOKEN=

# Optional — GitHub personal access token for the releases API.
# Without it the check-update endpoint is rate-limited to 60 req/hour per IP.
# A fine-grained token with public repo read access is enough.
GITHUB_TOKEN=
