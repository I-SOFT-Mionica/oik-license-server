# Copy to .env and fill in real values before running.
# After the CI/CD deploy workflow is set up, .env is written automatically
# from GitHub Secrets on every deploy — do NOT edit it manually on the server.

# REQUIRED — at least 32 random characters.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# REQUIRED — password for the /admin/ web UI and the installer upload endpoint.
# Generate with: python -c "import secrets; print(secrets.token_hex(24))"
ADMIN_TOKEN=

# Optional — GitHub personal access token for the releases API fallback.
# Without it the check-update GitHub fallback is rate-limited to 60 req/hour per IP.
# A fine-grained token with public repo read access is enough.
GITHUB_TOKEN=

# Public base URL of this server — included in download_url returned by check-update.
# Change only if you move the server to a different domain.
SERVER_BASE_URL=https://api.isoft.rs
